{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence",
  "version": "1.0.0",
  "identifier": "app.cadence.desktop",
  "build": {
    "frontendDist": "https://jarvis-saas-seven.vercel.app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
